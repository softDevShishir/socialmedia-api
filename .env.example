# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialmedia_db
DB_USER=socialmedia_user
DB_PASSWORD=socialmedia_password

# JWT Configuration
JWT_SECRET=your-secret-key-min-256-bits-long-for-production-change-this
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# Application Profile
SPRING_PROFILES_ACTIVE=dev

# Logging
LOG_LEVEL=INFO
