        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"bio\": \"Updated bio from Postman\",\n  \"profileImage\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{user_id}}"]
            },
            "description": "Update the authenticated user's own profile. `userId` in the path must match the caller's own ID.\n\n**Auth required.** Responses: 200 OK, 400 validation failed, 401 missing/invalid token, 403 not your profile, 404 not found, 409 username taken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Bio was updated', function () {",
                  "    pm.expect(pm.response.json().bio).to.eql('Updated bio from Postman');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
